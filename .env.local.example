# Copy to .env.local and fill in to make the contact form (components/contact.tsx,
# app/api/contact/route.ts) actually send email, via Resend: https://resend.com
#
# Uses the dialectrek.com domain, which is already verified in the Resend account -- no need to
# verify a new domain or pay for another one. Get an API key from that same Resend account (any
# key on the account works, since domain verification is account-wide, not per-key).
RESEND_API_KEY=random-alphanumeric-string
RESEND_FROM_EMAIL="Matt Downey <contact@dialectrek.com>"

# Where contact form submissions get sent. Defaults to the email in lib/content.ts if unset.
CONTACT_EMAIL=mattdowney421@gmail.com
